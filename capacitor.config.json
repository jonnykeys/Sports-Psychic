{
  "appId": "com.sportspsychic.app",
  "appName": "Sports Psychic",
  "webDir": "OG League Live",
  "bundledWebRuntime": false,
  "backgroundColor": "#080c14",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#080c14",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#080c14",
      "overlaysWebView": true
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
